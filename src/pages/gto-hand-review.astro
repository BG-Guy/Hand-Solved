---
// gto-hand-review.astro: route "/gto-hand-review". Thin on purpose: section order only, each section owns its content (UX.md 5.1).
// The hero owns the breadcrumb and the H1. #worked-example is the no-script target of every demo button. The closing band is printed by SiteFooter, so it is not placed here.
import Faq from '../components/Faq/Faq.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../sections/gto-hand-review/Hero.astro';
import HowGraded from '../sections/gto-hand-review/HowGraded.astro';
import Limits from '../sections/gto-hand-review/Limits.astro';
import RelatedLinks from '../components/RelatedLinks/RelatedLinks.astro';
import WhatYouSee from '../sections/gto-hand-review/WhatYouSee.astro';
import WorkedExample from '../sections/gto-hand-review/WorkedExample.astro';
import { reviewFaq } from '../sections/gto-hand-review/faq';
import { pages } from '../data/pages';

const page = pages.gtoHandReview;
---
<SiteLayout page={page}>
  <Hero />
  <WorkedExample />
  <HowGraded />
  <WhatYouSee />
  <Limits />
  <Faq heading={reviewFaq.heading} items={reviewFaq.items} index={reviewFaq.index} />
  <RelatedLinks
    links={[
      { label: 'Record a hand at the table', href: '/live-poker-hand-recorder' },
      { label: 'See the concept pricing', href: '/#pricing' },
    ]}
  />
</SiteLayout>
