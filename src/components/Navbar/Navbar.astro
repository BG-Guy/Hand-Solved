---
// Navbar.astro: the floating header (DESIGN.md 9.2): brand, four links with a gliding hover slip, the demo button, and below 1024 px a burger that opens
// a full-screen menu panel (a modal <dialog>, so focus is trapped, Esc closes it and the page behind is inert).
// SiteLayout prints it on every page; a page does not place it. States: over the page (no ground), compact on scroll, link default, hover, focus, current,
// section-current (home), menu open. Navbar.ts does the scroll, slip, section and menu work; with no script the links wrap under the brand.
//
// Hooks for the motion task (MOTION.md E03 to E06): <header class="site-header" data-scrolled>, .nav__pill (--x, --w), .nav__menu[data-state="open"] with --mx / --my.
import ConceptNote from '../ConceptNote/ConceptNote.astro';
import CtaButton from '../CtaButton/CtaButton.astro';
import Icon from '../Icon/Icon.astro';
import { svgFile } from '../Icon/svg-files';
import { brandLinkLabel, labels, navLinks } from '../../data/site';
import './Navbar.css';

interface Props {
  /** Canonical path of the page ("/" for home, "/gto-hand-review" and so on). Marks the current link, and keeps #how and #pricing on the page when on home. */
  path: string;
  /** True on pages whose hero has a demo button (data-cta="hero"). The header button then starts as secondary and turns primary once the hero button leaves the screen. */
  heroCta?: boolean;
}

const { path, heroCta = false } = Astro.props;
const onHome = path === '/';
// On home the two section links stay on the page. Elsewhere they go to the home page section.
const links = navLinks.map((link) => ({
  label: link.label,
  href: onHome && link.homeHref ? link.homeHref : link.href,
  current: link.href === path,
}));
const Lockup = svgFile('logo-lockup');
---
<header class="nav site-header" data-nav>
  <div class="nav__bar">
    <a class="nav__brand" href="/" aria-label={brandLinkLabel}>
      <Lockup class="nav__lockup" aria-hidden="true" focusable="false" />
    </a>
    <nav class="nav__links" aria-label={labels.navPrimary}>
      <span class="nav__pill" aria-hidden="true"></span>
      <ul role="list">
        {links.map((link) => <li><a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a></li>)}
      </ul>
    </nav>
    <CtaButton dialog="dlg-sample" cta="header" size="sm" variant={heroCta ? 'secondary' : 'primary'} class="nav__cta" />
    <button class="nav__toggle" id="nav-toggle" type="button" aria-label={labels.openMenu} aria-haspopup="dialog" aria-controls="nav-menu" data-nav-toggle>
      <Icon name="menu" size={24} />
      <span class="nav__toggle-text">{labels.menu}</span>
    </button>
  </div>
  <dialog class="nav__menu on-ink" id="nav-menu" aria-label={labels.menu} data-return-focus="nav-toggle">
    <div class="nav__menu-top">
      <a class="nav__brand" href="/" aria-label={brandLinkLabel}>
        <Lockup class="nav__lockup" aria-hidden="true" focusable="false" />
      </a>
      <button class="nav__toggle nav__menu-close" type="button" aria-label={labels.closeMenu} data-nav-close autofocus>
        <Icon name="close" size={24} />
      </button>
    </div>
    <nav class="nav__menu-nav" aria-label={labels.menu}>
      <ul role="list">
        {links.map((link) => <li><a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a></li>)}
      </ul>
    </nav>
    <div class="nav__menu-foot">
      <CtaButton dialog="dlg-sample" cta="menu" size="lg" full fallback={false} />
      <ConceptNote />
    </div>
  </dialog>
</header>
<script src="./Navbar.ts"></script>
