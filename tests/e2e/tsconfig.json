// Type-check for the end-to-end tests only: `npx tsc -p tests/e2e --noEmit`. The root tsconfig covers src/ alone, so these files never reach `astro check`.
{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": []
  },
  "include": ["./**/*.ts", "../../playwright.config.ts"]
}
